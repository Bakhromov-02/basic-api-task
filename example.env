API_PORT=7000

# PostgreSQL. With `docker compose up` the app reaches the database at db:5432 automatically;
# TYPEORM_HOST/TYPEORM_PORT below are for running the API on your machine (`npm run start:dev`).
TYPEORM_HOST=localhost
TYPEORM_PORT=5433
TYPEORM_USERNAME=admin
TYPEORM_PASSWORD=change-me
TYPEORM_DATABASE=users
TYPEORM_LOGGING=false

# Use long random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
